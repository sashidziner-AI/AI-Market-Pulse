# ANTHROPIC_API_KEY: Required for Claude API calls (Opus 4.7 primary + Haiku 4.5 fallback).
# Obtain from https://console.anthropic.com/settings/keys
# If missing, every /api/* endpoint silently returns hand-authored fallback data
# with `isFallback: true` and the frontend shows a "simulated data" banner.
ANTHROPIC_API_KEY="sk-ant-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HUNTER_API_KEY: Optional. Enables real stakeholder enrichment (name + LinkedIn profile URL)
# via Hunter.io Domain Search. Free tier = 25 searches/mo. If missing, the app falls back
# to the local synthesized-name placeholder.
# Obtain from https://hunter.io/api-keys
HUNTER_API_KEY=""
