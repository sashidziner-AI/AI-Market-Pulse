# AI provider — set ONE (or both). If both are set, ANTHROPIC_API_KEY wins.
# Without either, every /api/* endpoint silently returns hand-authored fallback
# data with `isFallback: true` and the frontend shows a "simulated data" banner.
#
# ANTHROPIC_API_KEY: Preferred. Enables Claude Opus 4.7 + native web_search grounding.
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
#
# OPENAI_API_KEY: Fallback provider. Enables GPT-4o via Chat Completions.
# Note: web_search flag becomes a no-op on OpenAI Chat Completions path;
# grounded discovery would require moving to the Responses API + web_search_preview tool.
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HUNTER_API_KEY: Optional. Enables real stakeholder enrichment (name + LinkedIn profile URL)
# via Hunter.io Domain Search. Free tier = 25 searches/mo. If missing, the app falls back
# to the local synthesized-name placeholder.
# Obtain from https://hunter.io/api-keys
HUNTER_API_KEY=""

# PROXYCURL_API_KEY: Optional. Enables real LinkedIn profile verification
# for Phase P1 lead re-verification. Powers `POST /api/leads/:id/refresh`.
# Without it, refresh returns a stub response (verified with no changes).
# Pricing: ~$0.01–0.03 per profile lookup, free tier = 10 credits.
# Obtain from https://nubela.co/proxycurl
PROXYCURL_API_KEY=""

# ─── Scheduled re-runs ─────────────────────────────────────────────────────
# ENABLE_SCHEDULER: Arm the cron jobs. Default: false. Manual "Run now" from
# the UI works either way — the flag only controls automated firing.
ENABLE_SCHEDULER="false"

# Cron overrides for each background job. Format: "min hour dom month dow"
# (server-local timezone). Invalid values fall back to the defaults with a
# console warning. LABEL vars set the human-readable schedule shown in the
# UI card; if omitted, the raw cron string is displayed.
#
# Common patterns:
#   */5 * * * *     every 5 minutes (great for demo)
#   0 * * * *       hourly on the hour
#   0 */6 * * *     every 6 hours
#   30 8 * * *      daily at 08:30
#   0 9 * * 1-5     weekdays at 09:00
#   0 8,18 * * *    twice a day at 08:00 and 18:00
LEAD_HEALTH_CRON="0 2 * * *"
LEAD_HEALTH_LABEL="Daily at 02:00"
PATTERN_REFRESH_CRON="0 3 * * 0"
PATTERN_REFRESH_LABEL="Sundays at 03:00"
# persona-discovery walks the enrollment queue (data/enrichment-queue.json)
# and enriches decision-maker personas via Hunter — real matches auto-drop
# into Leads with source="auto". Enroll accounts by POSTing to
# /api/scheduler/enroll (the Dashboard does this automatically after each
# discoverAccounts() completes).
PERSONA_DISCOVERY_CRON="0 4 * * *"
PERSONA_DISCOVERY_LABEL="Daily at 04:00"
